<!DOCTYPE html>
<html>
<head><body bgcolor="lightgreen"></body>
    <title>Campus Bazar Admin Registration</title>
</head>
<body>

    <h1 align="center">
        <font color="lightblue">Campus Bazar</font>
    </h1>
    <h2 align="center">Admin Registration</h2>

    <form>
        <table align="center" cellpadding="8">
            <tr>
                <td><label for="name">Full Name:</label></td>
                <td><input type="text" id="name" name="name"
                placeholder="Enter full name" required></td>
            </tr>

            <tr>
                <td><label for="email">Email:</label></td>
                <td><input type="email" id="email" name="email"
                placeholder="Enter email" required></td>
            </tr>

            <tr>
                <td><label for="adminid">Admin ID:</label></td>
                <td><input type="text" id="adminid" name="adminid"
                placeholder="Enter admin ID" required></td>
            </tr>

            <tr>
                <td><label for="phone">Phone:</label></td>
                <td><input type="tel" id="phone" name="phone"
                placeholder="Enter phone number" required></td>
            </tr>

            <tr>
                <td><label for="role">Admin Role:</label></td>
                <td>
                    <select id="role" name="role">
                        <option>Select Role</option>
                        <option>Super Admin</option>
                        <option>Product Manager</option>
                        <option>Order Manager</option>
                    </select>
                </td>
            </tr>

            <tr>
                <td><label for="password">Password:</label></td>
                <td><input type="password" id="password"
                name="password" placeholder="Enter password" required></td>
            </tr>

            <tr>
                <td><label for="confirm">Confirm Password:</label></td>
                <td><input type="password" id="confirm"
                name="confirm" placeholder="Confirm password" required></td>
            </tr>

            <tr>
                <td colspan="2" align="center">
                    <input type="submit" value="Register Admin">
                    <input type="reset" value="Clear">
                </td>
            </tr>
        </table>
    </form>

</body>
</html>
